# ===== BACKEND - CONFIGURAÇÕES =====

# SERVER
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=sua_secret_jwt_super_seguro_mude_em_producao_12345
JWT_EXPIRE=7d

# DATABASE (Escolha uma)
# Opção 1: SQLite (Padrão para desenvolvimento)
DB_TYPE=sqlite
# DB_PATH deixado em branco para usar padrão: ../data/dashboard.db relativo ao arquivo de conexão

# CORS
CORS_ORIGIN=http://localhost:5000,http://localhost:3000,http://localhost:8080

# RATE LIMITING
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# LOGGING
LOG_LEVEL=info
