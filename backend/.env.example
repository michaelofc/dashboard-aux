# ===== BACKEND - CONFIGURAÇÕES =====

# SERVER
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=seu_secret_jwt_super_seguro_aqui_mude_em_producao
JWT_EXPIRE=7d

# DATABASE (Escolha uma)
# Opção 1: PostgreSQL (Recomendado para produção)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=dashboard_user
DB_PASSWORD=senha_forte_aqui
DB_NAME=dashboard_inadimplencia

# Opção 2: SQLite (Para desenvolvimento)
# DB_TYPE=sqlite
# DB_PATH=./data/dashboard.db

# GOOGLE SHEETS (Integração de dados)
GOOGLE_SHEETS_API_KEY=sua_chave_google_sheets_aqui
GOOGLE_SHEET_ID=seu_id_da_planilha_aqui

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# RATE LIMITING
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# LOGGING
LOG_LEVEL=info
